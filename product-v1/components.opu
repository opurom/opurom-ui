// OPUROM Product UI Standard v1 components.
// The product preset is the default UI standard for examples and hosts.
// Each component lowers to deterministic primitive IR at compile time.
// No external product or brand names are used.

component ProductAppBar(title: string, state: string) {
  Container(height: 64, p: 16, rounded: 0, shadow: 0, color: "#FFFFFF", textColor: "#132C5A", border: "#DCE4EF", state: "{state}", label: "app bar") {
    Row(gap: 12, align: center) {
      Text("{title}", size: 22, fontPx: 22, weight: "bold", color: "#132C5A")
    }
  }
}

component ProductCard(title: string, value: string, state: string) {
  Container(p: 16, rounded: 16, shadow: 1, color: "#FFFFFF", textColor: "#132C5A", border: "#DCE4EF", state: "{state}", label: "card") {
    Column(gap: 8, align: end) {
      Text("{title}", size: 12, fontPx: 12, color: "#5A6478")
      Text("{value}", size: 64, fontPx: 64, weight: "bold", color: "#132C5A")
    }
  }
}

component ProductButton(label: string, variant: string, state: string, size: int) {
  Button("{label}", variant: "{variant}", p: 8, rounded: 12, margin: 2, shadow: 1, state: "{state}") {}
}

component ProductIconButton(label: string, state: string) {
  Button("{label}", variant: "ghost", p: 12, rounded: 999, margin: 2, shadow: 0, state: "{state}") {}
}

component ProductInput(label: string, value: string, state: string) {
  Container(p: 12, rounded: 12, color: "#FFFFFF", textColor: "#132C5A", border: "#DCE4EF", shadow: 0, state: "{state}", label: "input") {
    Column(gap: 4) {
      Text("{label}", size: 12, fontPx: 12, color: "#5A6478")
      Text("{value}", size: 16, fontPx: 16, color: "#132C5A")
    }
  }
}

component ProductSwitch(label: string, state: string) {
  Button("{label}", variant: "secondary", p: 8, rounded: 999, margin: 2, shadow: 0, state: "{state}") {}
}

component ProductSlider(label: string, state: string) {
  Button("{label}", variant: "secondary", p: 8, rounded: 999, margin: 2, shadow: 0, state: "{state}") {}
}

component ProductListItem(title: string, subtitle: string, state: string) {
  Container(p: 12, rounded: 12, color: "#FFFFFF", textColor: "#132C5A", border: "#DCE4EF", shadow: 0, state: "{state}", label: "list item") {
    Column(gap: 4) {
      Text("{title}", size: 16, fontPx: 16, color: "#132C5A")
      Text("{subtitle}", size: 14, fontPx: 14, color: "#5A6478")
    }
  }
}

component ProductTabs(label: string, state: string) {
  Container(p: 8, rounded: 12, color: "#FFFFFF", textColor: "#132C5A", border: "#DCE4EF", shadow: 0, state: "{state}", label: "tabs") {
    Text("{label}", size: 14, fontPx: 14, weight: "bold", color: "#132C5A")
  }
}

component ProductDialog(title: string, body: string, state: string) {
  Container(p: 24, rounded: 24, shadow: 3, color: "#FFFFFF", textColor: "#132C5A", border: "#DCE4EF", state: "{state}", label: "dialog") {
    Column(gap: 16) {
      Text("{title}", size: 24, fontPx: 24, weight: "bold", color: "#132C5A")
      Text("{body}", size: 14, fontPx: 14, color: "#5A6478")
    }
  }
}

component ProductBadge(label: string, state: string) {
  Container(p: 6, rounded: 999, color: "#0A71FC", textColor: "#FFFFFF", border: "#0A71FC", shadow: 0, state: "{state}", label: "badge") {
    Text("{label}", size: 11, fontPx: 11, weight: "bold", color: "#FFFFFF")
  }
}

component ProductProgress(label: string, state: string) {
  Container(p: 8, rounded: 999, color: "#EDF2F8", textColor: "#132C5A", border: "#DCE4EF", shadow: 0, state: "{state}", label: "progress") {
    Text("{label}", size: 12, fontPx: 12, color: "#5A6478")
  }
}
