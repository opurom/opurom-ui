// Additive five-state wrappers for legacy presentation shells.
// Flutter stable 3.50.0 state vocabulary: WidgetState.default/pressed/hovered/
// focused/disabled in widgets.dart WidgetState enum; Opurom IR carries the
// mapped names default/active/hover/focus/disabled as a static `state` prop.

// StateAppBarShell: state-aware wrapper around AppBarShell; existing API and digests unchanged.
component StateAppBarShell(state: string) {
  Container(state: "{state}", label: "StateAppBarShell") {
    AppBarShell("x", "home", "home", "{state}")
  }
}

