// Declarative form shells. Flutter stable 3.50.0 source anchors:
//   form.dart:318,360          FormState.save() / FormState.validate()
//   form.dart:78-79            autovalidateMode defaults to disabled
//   input_decorator.dart:40    167ms decoration transition (reference only)
//   motion.dart:44            150ms short3 Opurom transition token
// Component parameters are literals, so FormState/autovalidate/onSubmit
// require the reviewed action-parameter kernel change (COMPONENT_CALLBACK_PROPOSAL.md)
// and stay reserved; no runtime interpretation is added here.
// Boundary: empty titles render an empty caption; long values clip in the Input;
// required/minLength/maxLength are literal props evaluated by the Input primitive.

// FormFieldM3: labelled single-line field with literal validation props.
// API   R: label. O: placeholder, required, minLength, maxLength, state, animate.
//       X: bind, validator callback, FormState (B4).
// Example FormFieldM3("Email", "you@example.com", true, 3, 60, "error", "ease")
component FormFieldM3(label: string, placeholder: string, required: bool, minLength: int, maxLength: int, state: string, animate: string) {
  Column(gap: 6, state: "{state}", animate: "{animate}", duration: 150, label: "form field", role: "text") {
    Text("{label}", size: 11)
    Input(placeholder: "{placeholder}", required: required, minLength: minLength, maxLength: maxLength, state: "{state}", animate: "{animate}", duration: 150)
  }
}

// FormSectionM3: titled group of two literal-validated fields.
// API   R: title. O: firstLabel, secondLabel, required, state, animate.
//       X: per-field bind, cross-field linkage, submit handler (B4).
// Example FormSectionM3("Sign in", "Email", "Password", true, "default", "ease")
component FormSectionM3(title: string, firstLabel: string, secondLabel: string, required: bool, state: string, animate: string) {
  Container(p: 12, rounded: 12, variant: "secondary", state: "{state}", animate: "{animate}", duration: 150, label: "form section", role: "heading") {
    Column(gap: 8) {
      Text("{title}", size: 16)
      Text("{firstLabel}", size: 11)
      Input(placeholder: "{firstLabel}", required: required, state: "{state}", animate: "{animate}", duration: 150)
      Text("{secondLabel}", size: 11)
      Input(placeholder: "{secondLabel}", required: required, secure: true, state: "{state}", animate: "{animate}", duration: 150)
    }
  }
}
