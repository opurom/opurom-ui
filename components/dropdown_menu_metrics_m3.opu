// Material 3 dropdown menu default geometry. Flutter stable 3.50.0 sources:
//   dropdown_menu.dart:63            112dp minimum field/menu width
//   dropdown_menu.dart:1628-1655     width clamp uses the same minimum
//   dropdown_menu.dart:1711-1733     M3 bodyLarge text, OutlineInputBorder,
//                                    disabled onSurface 0.38, standard density
//   motion.dart:52                   200ms short4 state transition
// The existing DropdownMenuM3 pin is unchanged. This additive shell records
// the source-backed minimum width and outline field. Filtering, popup routing
// and selection callbacks need kernel gaps A3/A4/B3 and stay at the call site.
// Boundary: an empty label renders an empty field; overlong options clip in the
// Menu primitive; out-of-range values are bounded by ComboBox.
// Example DefaultDropdownMenuM3("Country", 0, "United States,Canada,Mexico", "Choose", "default", "ease")
component DefaultDropdownMenuM3(label: string, value: int, options: string, placeholder: string, state: string, animate: string) {
  Container(width: 112, p: 12, rounded: 12, variant: "secondary", state: "{state}", animate: "{animate}", duration: 200, label: "dropdown menu default", role: "button") {
    Column(gap: 8) {
      Text("{label}", size: 16, maxLines: 1, state: "{state}")
      ComboBox(value: value, state: "{state}", animate: "{animate}", duration: 200, label: "{placeholder}")
      Menu(items: "{options}", state: "{state}", animate: "{animate}", duration: 200, label: "dropdown options")
    }
  }
}
