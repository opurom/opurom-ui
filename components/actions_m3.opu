// Material 3 FAB family — state-complete shells over the renderer primitives.
// Source: Flutter stable 3.50.0
//   floating_action_button.dart:86-104      public FAB constructor parameters
//   floating_action_button.dart:404-405     56dp regular / 40dp small sizes
//   floating_action_button.dart:730-731     tight 56 / 40 / 96 size constraints
//   floating_action_button.dart:756,816-820 circle shape and M3 corner radii
//   floating_action_button.dart:603         tooltip wrapping
//   motion.dart:52                         200ms short4 duration token
// Geometry: regular FAB is 56x56 circle (radius 28), small is 40x40 circle
// (radius 20), extended FAB is 48dp tall stadium with the label inside.
// Eight design states pass through to the renderer state transform. loading,
// success and error are Opurom business states (NO_FLUTTER_EQUIVALENT).
// API   R: icon. O: state, animate.
//       X: foregroundColor/backgroundColor/elevation (theme resolver, M4),
//          mini/location/heroTag (A4), 6dp touch target beyond the visual box.
// Boundary: empty icon still renders the circular target; unknown icon names
// fall back to the renderer's default glyph; overlong label clips in extended.
// Example FabM3("plus", "default", "ease")
component FabM3(icon: string, state: string, animate: string) {
  Container(width: 56, height: 56, rounded: 28, variant: "primary", shadow: 2, state: "{state}", animate: "{animate}", duration: 200, gesture: tap, label: "FAB", role: "button") {
    Icon(name: "{icon}", width: 24, height: 24)
  }
}

// Small FAB: 40dp circle per floating_action_button.dart:405,730.
// Example SmallFabM3("plus", "hover", "ease")
component SmallFabM3(icon: string, state: string, animate: string) {
  Container(width: 40, height: 40, rounded: 20, variant: "primary", shadow: 2, state: "{state}", animate: "{animate}", duration: 200, gesture: tap, label: "small FAB", role: "button") {
    Icon(name: "{icon}", width: 24, height: 24)
  }
}

// Extended FAB: 48dp tall stadium per floating_action_button.dart:732,820.
// API   R: label. O: icon, state, animate.
//       X: icon label spacing 8dp (:733; the Row gap is the stand-in).
// Example ExtendedFabM3("Create", "plus", "default", "ease")
component ExtendedFabM3(label: string, icon: string, state: string, animate: string) {
  Container(height: 48, rounded: 24, variant: "primary", shadow: 2, state: "{state}", animate: "{animate}", duration: 200, gesture: tap, label: "extended FAB", role: "button") {
    Row(padding: 16, gap: 8) {
      Icon(name: "{icon}", width: 24, height: 24)
      Text("{label}", size: 14)
    }
  }
}

// Large FAB: 96dp circle per floating_action_button.dart:731,819 (radius 28
// on the M3 shape, kept here as the circle radius half the width).
// Example LargeFabM3("plus", "focus", "ease")
component LargeFabM3(icon: string, state: string, animate: string) {
  Container(width: 96, height: 96, rounded: 48, variant: "primary", shadow: 2, state: "{state}", animate: "{animate}", duration: 200, gesture: tap, label: "large FAB", role: "button") {
    Icon(name: "{icon}", width: 36, height: 36)
  }
}
