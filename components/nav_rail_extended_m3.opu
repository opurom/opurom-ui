// Material 3 extended navigation rail presentation. Flutter stable 3.50.0 sources:
//   navigation_rail.dart:1233-1242  elevation 0, top alignment, minWidth 80,
//                                   minExtendedWidth 256, indicator enabled
//   navigation_rail.dart:1250-1272  labelMedium, 24dp icons, secondaryContainer
//                                   selected indicator
//   motion.dart:52                  200ms short4 state transition
// The existing closed NavigationRailM3 pin is unchanged. This additive shell
// records the extended M3 geometry with side labels. Route callbacks, the
// extended animation and selection binding stay at the call site (A3/A4/B3).
// Boundary: empty labels render empty destinations; overlong labels clip in the
// 256dp rail; out-of-range selection is clamped by the NavRail primitive.
// Example ExtendedNavigationRailM3("Home,Search,Profile", 1, "default", "ease")
component ExtendedNavigationRailM3(labels: string, selected: int, state: string, animate: string) {
  Container(width: 256, p: 8, variant: "secondary", state: "{state}", animate: "{animate}", duration: 200, label: "extended navigation rail", role: "none") {
    NavRail(value: selected, segments: 3, labels: "{labels}", state: "{state}", animate: "{animate}", duration: 200, label: "rail destinations")
  }
}
