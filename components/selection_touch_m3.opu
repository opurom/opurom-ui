// Touch-target wrappers reuse the pinned selection shells; checked values remain call-site literals.

// M3 48dp minimum touch target wrappers for selection controls. Flutter
// stable 3.50.0 sources:
//   material/constants.dart:27        48dp minimum interactive dimension
//   checkbox.dart:1033-1041           M3 splash radius 20, 2dp corner
//   checkbox.dart:923-954             state-layer alphas 0.10/0.08/0.10
//   radio.dart (M3 defaults)          18dp outer, 48dp tap target
//   motion.dart:52                    200ms short4 state transition
// Opurom IR expresses the touch box as static Container geometry. These
// wrappers do not change the existing 18dp visual shells or their pins; bind
// and checked values stay at the call site (A3/B4).
// Example TouchCheckboxM3("default", "ease")
component TouchCheckboxM3(state: string, animate: string) {
  Container(width: 48, height: 48, rounded: 24, variant: "text", state: "{state}", label: "checkbox touch target") {
    CheckboxM3("{state}", "{animate}")
  }
}

component TouchRadioM3(state: string, animate: string) {
  Container(width: 48, height: 48, rounded: 24, variant: "text", state: "{state}", label: "radio touch target") {
    RadioM3("{state}", "{animate}")
  }
}

import "components/selection_m3.opu";
