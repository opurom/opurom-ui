// Material 3 combined date-time picker presentation shell. Flutter stable
// 3.50.0 source anchors:
//   date_picker.dart:196-215            showDatePicker initialDate/firstDate/
//                                       lastDate and initial entry mode
//   date_picker.dart:228-244            date range/ordering assertions
//   time_picker.dart:3246-3290          showTimePicker initialTime, cancel/
//                                       confirm/help labels, entry mode
//   time_picker.dart:2297-2331          TimePickerDialog initial time and
//                                       label parameters
//   date_picker.dart:791-801            header/content divider
//   motion.dart:52                      200ms short4 state transition
// Opurom component arguments are literals, so date and time are integer
// slots; DateTime/TimeOfDay conversion, two-step route presentation and
// onChanged callbacks need kernel gaps A3/A4/B3 and stay reserved.
// This shell does not fake wheel physics or calendar interpolation.
// Boundary: the caller owns date/time range validity; empty labels render an
// empty caption; overlong labels clip inside the DateField/TimeField nodes.
// Example DateTimePickerM3("Departure", 18, 9, 1, "default", "ease")
component DateTimePickerM3(label: string, date: int, time: int, use24h: int, state: string, animate: string) {
  Container(p: 12, rounded: 12, variant: "secondary", state: "{state}", animate: "{animate}", duration: 200, gesture: tap, label: "date time picker", role: "button") {
    Column(gap: 8) {
      Text("{label}", size: 11)
      DateField(value: date, state: "{state}", animate: "{animate}", duration: 200, label: "date value")
      Divider()
      TimeField(value: time, state: "{state}", animate: "{animate}", duration: 200, label: "time value")
    }
  }
}
