// Responsive Material 3 color picker panel presentation. Flutter stable 3.50.0 sources:
//   painting/colors.dart:420-432  ColorSwatch is a color plus a keyed shade table
//   material/colors.dart:174-204  primary swatches expose 50..900 shade keys
//   material/colors.dart:1912-1937 Colors.primaries lists the material swatches
//   rendering/sliver_grid.dart:174-190,354-375 fixed crossAxisCount, spacing
//   rendering/sliver_grid.dart:449-518 maxCrossAxisExtent derives column count
//   widgets/media_query.dart:34-39,855 width > height selects landscape
//   render/src/layout.rs:50-109 compact/medium/expanded tiers and fluid grid
// Flutter framework has no standalone color-picker widget, so this additive
// shell is a deterministic M3 swatch-grid presentation, not a picker parity
// claim. Opurom's existing Grid primitive derives compact column counts from
// compactColumns and expands through the fluid grid at wider tiers. Selected
// shade, callbacks, eyedropper and text entry stay at the call site (A3/A4/B4).
// loading/success/error are Opurom business states (NO_FLUTTER_EQUIVALENT).
// Boundary: an empty label renders an unnamed panel; overlong labels clip in
// the text node; out-of-range state is compiler-rejected.
// Example ResponsiveColorPickerPanelM3("Blue", "default", "ease")
component ResponsiveColorPickerPanelM3(label: string, state: string, animate: string) {
  Container(p: 8, variant: "text", label: "responsive color picker host") {
    Grid(columns: 6, compactColumns: 2, state: "{state}", label: "color swatch tiers", role: "none") {
      Text("{label}", size: 14, maxLines: 1, state: "{state}")
      Container(p: 8, rounded: 8, variant: "primary", state: "{state}", animate: "{animate}", duration: 200, label: "swatch 50")
      Container(p: 8, rounded: 8, variant: "secondary", state: "{state}", animate: "{animate}", duration: 200, label: "swatch 200")
      Container(p: 8, rounded: 8, variant: "primary", state: "{state}", animate: "{animate}", duration: 200, label: "swatch 500")
      Container(p: 8, rounded: 8, variant: "secondary", state: "{state}", animate: "{animate}", duration: 200, label: "swatch 800")
      Container(p: 8, rounded: 8, variant: "text", state: "{state}", animate: "{animate}", duration: 200, label: "swatch outline")
    }
  }
}
