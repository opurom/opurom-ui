{
  "purpose": "responsive page-state layout catalog: loading/empty/error/success at compact, medium and expanded tiers; internal Opurom pins, not Flutter pixel parity",
  "flutter": {
    "version": "stable 3.50.0",
    "commit": "ab2912035e160d9cad6306df307576da6128ebdb",
    "noPageStateWidget": "NO_FLUTTER_EQUIVALENT",
    "progress": "progress_indicator.dart:48-90,1611-1637",
    "listTile": "list_tile.dart:388-425",
    "icon": "icons.dart:5370-5371",
    "motion": "material/motion.dart:52",
    "breakpoints": "render/src/layout.rs:50-74"
  },
  "toolchain": {
    "meta": "test/state-digests.json",
    "profile": "debug",
    "tick": 4000
  },
  "tiers": [
